generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  password                String
  fullName                String
  createdAt               DateTime                 @default(now())
  brainSettings           BrainSettings?
  notificationPreferences NotificationPreferences?
  notifications           Notification[]
  reminders                Reminder[]
  media                   ChatMedia[]
  conversations           Conversation[]
  memories                Memory[]
  Project                 Project[]
  files                   StoredFile[]
  Thread                  Thread[]
  toolExecutions          ToolExecution[]
  usageRecords            UsageRecord[]
  apiKeys                 UserApiKey[]
  tasks                   Task[]
  goals                   Goal[]
  habits                  Habit[]
  notes                   Note[]
  researchItems           ResearchItem[]
  collections             Collection[]
  automations             Automation[]
}

model Conversation {
  id             String          @id @default(cuid())
  title          String?
  userId         String
  createdAt      DateTime        @default(now())
  type           String          @default("chat")
  storagePath    String?         @default("")
  threadId       String?
  settings       Json?           @default("{}")
  media          ChatMedia[]
  Thread         Thread?         @relation(fields: [threadId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  messages       Message[]
  toolExecutions ToolExecution[]
  pdfEmbeddings   PdfEmbedding[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  chatMediaId    String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  chatMedia      ChatMedia?   @relation(fields: [chatMediaId], references: [id])
}

model ToolExecution {
  id             String        @id @default(cuid())
  conversationId String?
  toolName       String
  status         String
  input          Json
  output         Json
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  userId         String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])
}

model Memory {
  id         String   @id @default(cuid())
  userId     String
  content    String
  category   String
  createdAt  DateTime @default(now())
  confidence Float    @default(1.0)
  importance Int      @default(1)
  pinned     Boolean  @default(false)
  source     String?
  title      String
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  Goal       Goal[]
}

model BrainSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  memoryEnabled Boolean  @default(true)
  autoExtract   Boolean  @default(true)
  allowUpdates  Boolean  @default(true)
  retentionDays Int      @default(365)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

model NotificationPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  enabled               Boolean  @default(true)
  reminderNotifications Boolean  @default(true)
  taskNotifications     Boolean  @default(true)
  goalNotifications     Boolean  @default(true)
  habitNotifications    Boolean  @default(true)
  browserNotifications  Boolean  @default(false)
  dailyBriefingEnabled  Boolean  @default(true)
  dailyBriefingTime     String   @default("08:00")
  quietHoursEnabled     Boolean  @default(false)
  quietHoursStart       String   @default("22:00")
  quietHoursEnd         String   @default("08:00")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  refId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Reminder {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String    @default("")
  remindAt  DateTime
  nextRunAt DateTime
  frequency String    @default("once")
  enabled   Boolean   @default(true)
  fired     Boolean   @default(false)
  notified  Boolean   @default(false)
  log       Json      @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  encryptedKey String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  model     String
  tokens    Int
  cost      Float    @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ChatMedia {
  id             String        @id @default(cuid())
  conversationId String?
  userId         String
  fileName       String
  mimeType       String
  filePath       String
  mediaType      String        @default("image")
  createdAt      DateTime      @default(now())
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id])
  messages       Message[]
}

model StoredFile {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String
  bucket      String
  storagePath String
  publicUrl   String?
  size        Int      @default(0)
  mimeType    String   @default("application/octet-stream")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  description String    @default("")
  priority    String    @default("medium")
  status      String    @default("todo")
  dueDate     DateTime?
  tags        String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  description String    @default("")
  targetDate  DateTime?
  status      String    @default("active")
  progress    Int       @default(0)
  sourceMemoryId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User        @relation(fields: [userId], references: [id])
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestones   Milestone[]
  sourceMemory Memory?     @relation(fields: [sourceMemoryId], references: [id], onDelete: SetNull)
}

model Milestone {
  id          String   @id @default(cuid())
  goalId      String
  title       String
  description String   @default("")
  status      String   @default("pending")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Habit {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  description String   @default("")
  frequency   String
  targetCount String?   @default("1")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id])
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  completions HabitCompletion[]
}

model HabitCompletion {
  id          String   @id @default(cuid())
  habitId     String
  completedAt DateTime @default(now())
  periodStart DateTime

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String
  content   String   @default("")
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model ResearchItem {
  id           String    @id @default(cuid())
  userId       String
  collectionId String
  title        String
  type         String
  content      String    @default("")
  sourceUrl    String?
  tags         String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  project Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items   ResearchItem[]
}

model Automation {
  id           String   @id @default(cuid())
  userId       String
  projectId    String?
  title        String
  triggerType  String
  schedule     String?
  actionType   String
  actionConfig Json      @default("{}")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  icon        String   @default("folder")
  color       String   @default("#f59e0b")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  User        User     @relation(fields: [userId], references: [id])
  Thread      Thread[]
  tasks       Task[]
  goals       Goal[]
  notes       Note[]
  habits      Habit[]
  collections Collection[]
  automations Automation[]
}

model Thread {
  id           String         @id @default(cuid())
  userId       String
  projectId    String
  title        String
  description  String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Conversation Conversation[]
  Project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  User         User           @relation(fields: [userId], references: [id])
}

model PdfEmbedding {
  id             String       @id @default(cuid())
  conversationId String
  chunkIndex     Int
  text           String
  vector         Float[]
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
